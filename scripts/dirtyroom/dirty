def cmd_input_drag(args):
    x1 = float(args.x1)
    y1 = float(args.y1)
    x2 = float(args.x2)
    y2 = float(args.y2)
    duration_ms = float(getattr(args, "duration", 300) or 300)

    win = get_window_info(getattr(args, "window_name", "Paladins"))
    if getattr(args, "relative", False):
        if not win:
            print("[!] Error: --relative specified but target window was not found.", file=sys.stderr)
            return 1
        x1 = win["x"] + x1 * win["width"]
        y1 = win["y"] + y1 * win["height"]
        x2 = win["x"] + x2 * win["width"]
        y2 = win["y"] + y2 * win["height"]

    button = getattr(args, "button", 1)
    down_hex = button_to_hex(button, state="down")
    up_hex = button_to_hex(button, state="up")

    if win:
        subprocess.run(["xdotool", "windowactivate", "--sync", str(win["window_id"])], check=False)
        time.sleep(0.05)

    run_ydotool("mousemove", "--absolute", str(int(x1)), str(int(y1)))
    time.sleep(0.03)
    run_ydotool("click", down_hex)
    time.sleep(0.02)

    steps = max(10, int(duration_ms / 20))
    step_delay = (duration_ms / 1000.0) / steps
    for i in range(1, steps + 1):
        t = i / steps
        cur_x = int(x1 + (x2 - x1) * t)
        cur_y = int(y1 + (y2 - y1) * t)
        run_ydotool("mousemove", "--absolute", str(cur_x), str(cur_y))
        time.sleep(step_delay)

    time.sleep(0.02)
    run_ydotool("click", up_hex)
    print(f"[*] Dragged from ({int(x1)}, {int(y1)}) to ({int(x2)}, {int(y2)}) over {duration_ms}ms")
    return 0

