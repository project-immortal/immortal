        print(f"[!] Warning: Database not found at {DB_PATH}. Run setup_dirtyroom.sh first.", file=sys.stderr)
        return None
    return sqlite3.connect(DB_PATH)

def cmd_status(args):
    conn = get_db()
    data = {
        "dirtyroom_root": DIRTYROOM_ROOT,
        "ghidra_project": os.path.join(GHIDRA_DIR, PROJECT_NAME + ".gpr"),
        "project_exists": os.path.exists(os.path.join(GHIDRA_DIR, PROJECT_NAME + ".gpr")),
        "binaries": [],
