def check_dependencies(bins):
    missing = [b for b in bins if shutil.which(b) is None]
    if missing:
        print(f"[!] Error: Missing required system dependencies: {', '.join(missing)}", file=sys.stderr)
        print("    Install them with: sudo pacman -S --needed gpu-screen-recorder ydotool xdotool", file=sys.stderr)
        sys.exit(1)

RECORD_PID_FILE = "/tmp/dirty_recorder.json"

def pid_is_running(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False

def cmd_record_start(args):
    check_dependencies(["gpu-screen-recorder"])
    recordings_dir = os.path.join(REPO_ROOT, "scratch", "recordings")
    os.makedirs(recordings_dir, exist_ok=True)

    if os.path.exists(RECORD_PID_FILE):
        try:
            with open(RECORD_PID_FILE, "r") as f:
                state = json.load(f)
            pid = state.get("pid")
            if pid and pid_is_running(pid):
                print(f"[!] Error: Recorder already running (PID: {pid}, output: {state.get('output_file')})", file=sys.stderr)
                return 1
        except Exception:
            pass

    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    out_file = args.output or os.path.join(recordings_dir, f"rec_{ts}.mp4")
    out_file = os.path.abspath(out_file)
    os.makedirs(os.path.dirname(out_file), exist_ok=True)

    preset = "agent" if (getattr(args, "agent", False) or getattr(args, "fast", False)) else "standard"
    res = args.resolution or ("854x480" if preset == "agent" else "1920x1080")
    fps = str(args.fps or (3 if preset == "agent" else 30))
    window = args.window or "screen"

    cmd = [
        "gpu-screen-recorder",
        "-w", window,
        "-s", res,
        "-f", fps,
        "-c", "mp4",
        "-o", out_file
    ]

    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    state = {
        "pid": proc.pid,
        "output_file": out_file,
        "start_time": time.time(),
        "preset": preset,
        "resolution": res,
        "fps": fps,
        "window": window,
    }
    with open(RECORD_PID_FILE, "w") as f:
        json.dump(state, f, indent=2)

    print(f"[*] Screen recording started (PID: {proc.pid})")
    print(f"    Output:     {out_file}")
    print(f"    Preset:     {preset} ({res} @ {fps}fps)")
    print(f"    Target:     {window}")
    return 0

def cmd_record_stop(args):
    if not os.path.exists(RECORD_PID_FILE):
        print("[!] No active recording found.", file=sys.stderr)
        return 1

    try:
        with open(RECORD_PID_FILE, "r") as f:
            state = json.load(f)
    except Exception as e:
        print(f"[!] Failed to read recorder state: {e}", file=sys.stderr)
        return 1

    pid = state.get("pid")
    out_file = state.get("output_file")
    if pid and pid_is_running(pid):
        try:
            os.kill(pid, signal.SIGINT)
        except ProcessLookupError:
            pass

        start_wait = time.time()
        while time.time() - start_wait < 5.0:
            if not pid_is_running(pid):
                break
            time.sleep(0.1)

        if pid_is_running(pid):
            print(f"[!] Process {pid} did not exit after SIGINT, forcing termination...", file=sys.stderr)
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass

    if os.path.exists(RECORD_PID_FILE):
        try:
            os.remove(RECORD_PID_FILE)
        except OSError:
            pass

    size_bytes = os.path.getsize(out_file) if out_file and os.path.exists(out_file) else 0
    size_kb = round(size_bytes / 1024, 2)
    print(f"[*] Screen recording stopped (PID: {pid}).")
    print(f"    Output: {out_file} ({size_kb} KB, {size_bytes} bytes)")
    return 0

def cmd_record_status(args):
