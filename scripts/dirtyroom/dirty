    p_pcap.add_argument("--limit", type=int, default=10, help="Max frames to inspect")
    p_pcap.set_defaults(func=cmd_pcap)

    p_disasm = sub.add_parser("disasm", help="Disassemble instructions at address/symbol via native objdump")
    p_disasm.add_argument("target", help="Address (0x...) or symbol name")
    p_disasm.add_argument("--binary", default="ShippingPC-ChaosGame.exe", help="Target binary in project")
    p_disasm.add_argument("--bytes", type=int, default=128, help="Number of bytes to disassemble")
    p_disasm.add_argument("--limit", type=int, default=30, help="Max instructions to display")
    p_disasm.set_defaults(func=cmd_disasm)

    p_xrefs = sub.add_parser("xrefs", help="Find cross-references to an address in binary sections")
    p_xrefs.add_argument("target", help="Target hex address (0x...)")
    p_xrefs.add_argument("--binary", default="MctsInterface.dll", help="Target binary in project")
    p_xrefs.set_defaults(func=cmd_xrefs)

    p_shot = sub.add_parser("screenshot", help="Capture game window or desktop screenshot")
    p_shot.add_argument("--output", help="Output file path (default: artifact directory)")
    p_shot.set_defaults(func=cmd_screenshot)

    p_game = sub.add_parser("game", help="Control and inspect Paladins game and server processes")
    p_game.add_argument("action", choices=["status", "kill", "start", "client", "logs"], help="Action to perform")
    p_game.add_argument("target", nargs="?", default="client", help="Target log to view for 'logs' or target map")
    p_game.add_argument("--map", default=None, help="Map URL or name to load in client")
    p_game.set_defaults(func=cmd_game)

    args = parser.parse_args()
    args.func(args)

