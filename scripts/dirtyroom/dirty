def cmd_record_clip(args):
    check_dependencies(["gpu-screen-recorder"])
    recordings_dir = os.path.join(REPO_ROOT, "scratch", "recordings")
    os.makedirs(recordings_dir, exist_ok=True)

    duration = float(args.duration or 5.0)
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    out_file = args.output or os.path.join(recordings_dir, f"clip_{ts}.mp4")
    out_file = os.path.abspath(out_file)
    os.makedirs(os.path.dirname(out_file), exist_ok=True)

    preset = "agent" if (getattr(args, "agent", False) or getattr(args, "fast", False)) else "standard"
    res = args.resolution or ("854x480" if preset == "agent" else "1920x1080")
    fps = str(args.fps or (3 if preset == "agent" else 30))
    window = args.window or "screen"

    cmd = [
        "gpu-screen-recorder",
        "-w", window,
        "-s", res,
        "-f", fps,
        "-c", "mp4",
        "-o", out_file
    ]

    print(f"[*] Recording {duration}s clip ({preset} {res}@{fps}fps) to {out_file}...")
    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        time.sleep(duration)
        proc.send_signal(signal.SIGINT)
        proc.wait(timeout=10)
    except Exception as e:
        proc.kill()
        print(f"[!] Recording interrupted or timed out: {e}", file=sys.stderr)
        return 1

    if not os.path.exists(out_file):
        print(f"[!] Output file was not created: {out_file}", file=sys.stderr)
        return 1

    size_bytes = os.path.getsize(out_file)
    size_kb = round(size_bytes / 1024, 2)
    print(f"[*] Clip recording completed successfully.")
    print(f"    Path: {out_file}")
    print(f"    Size: {size_kb} KB ({size_bytes} bytes)")
    if getattr(args, "json", False):
        print(json.dumps({
            "status": "ok",
            "path": out_file,
            "duration": duration,
            "size_bytes": size_bytes,
            "size_kb": size_kb
        }))
    return 0

YDOTOOL_SOCKET = "/tmp/.ydotool_socket"

def is_ydotoold_alive():
    if not os.path.exists(YDOTOOL_SOCKET):
        return False
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        s.connect(YDOTOOL_SOCKET)
        s.close()
        return True
    except (ConnectionRefusedError, OSError):
        return False

def ensure_ydotoold():
    check_dependencies(["ydotool", "ydotoold"])
    if not is_ydotoold_alive():
        if os.path.exists(YDOTOOL_SOCKET):
            try:
                os.remove(YDOTOOL_SOCKET)
            except OSError:
                pass
        subprocess.Popen(
            ["ydotoold", "--socket-path", YDOTOOL_SOCKET],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True
        )
        for _ in range(25):
            time.sleep(0.04)
            if is_ydotoold_alive():
                break

def run_ydotool(*args):
    ensure_ydotoold()
    env = os.environ.copy()
    env["YDOTOOL_SOCKET"] = YDOTOOL_SOCKET
    cmd = ["ydotool"] + [str(a) for a in args]
    return subprocess.run(cmd, env=env, capture_output=True, text=True)

def get_window_info(name="Paladins"):
    check_dependencies(["xdotool"])
    res = subprocess.run(["xdotool", "search", "--name", name], capture_output=True, text=True)
    if res.returncode != 0 or not res.stdout.strip():
        return None

    wids = [line.strip() for line in res.stdout.strip().splitlines() if line.strip()]
    best = None
    for wid in wids:
        geom_res = subprocess.run(["xdotool", "getwindowgeometry", wid], capture_output=True, text=True)
        if geom_res.returncode == 0:
            pos_m = re.search(r"Position:\s*(-?\d+),(-?\d+)", geom_res.stdout)
            dim_m = re.search(r"Geometry:\s*(\d+)x(\d+)", geom_res.stdout)
            if pos_m and dim_m:
                w = int(dim_m.group(1))
                h = int(dim_m.group(2))
                info = {
                    "window_id": int(wid),
                    "window_id_hex": hex(int(wid)),
                    "name": name,
                    "x": int(pos_m.group(1)),
                    "y": int(pos_m.group(2)),
                    "width": w,
                    "height": h
                }
                if w > 100 and h > 100:
                    return info
                if not best:
                    best = info
    return best

