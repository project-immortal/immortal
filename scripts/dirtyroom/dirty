def cmd_find(args):
    conn = get_db()
    if not conn:
        return
    query = f"%{args.query}%"
    cursor = conn.cursor()
    cursor.execute("""
        SELECT b.name, b.sha256, f.address, f.name, f.signature
        FROM functions f
        JOIN binaries b ON f.binary_id = b.id
        WHERE f.name LIKE ? OR f.demangled_name LIKE ?
        LIMIT ?
    """, (query, query, args.limit))
    rows = cursor.fetchall()
    conn.close()

    if getattr(args, "json", False):
        res = [{
            "binary": r[0], "sha256": r[1], "address": hex(r[2]), "name": r[3], "signature": r[4]
        } for r in rows]
        print(json.dumps(res, indent=2))
        return

    if getattr(args, "evidence", False):
        for bname, sha, addr, fname, sig in rows:
            print(f"### Evidence: Function `{fname}`")
            print(f"- **Binary**: `{bname}` (SHA-256: `{sha}`)")
            print(f"- **Virtual Address**: `0x{addr:016x}`")
            print(f"- **Observed Signature**: `{sig or fname}`\n")
        return

    if not rows:
        print(f"No functions found matching '{args.query}'")
        return
    print(f"Found {len(rows)} function(s) matching '{args.query}':")
    for bname, sha, addr, fname, sig in rows:
        print(f"  [{bname}] 0x{addr:016x}  {fname}")
        if sig and sig != fname:
            print(f"      Sig: {sig}")

