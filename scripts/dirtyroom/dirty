def key_to_events(key_spec):
    parts = key_spec.strip().split()
    if all(":" in p for p in parts):
        return parts

    k = key_spec.strip().lower()
    if k.startswith("key_"):
        k = k[4:]
    if k in KEY_NAME_MAP:
        code = KEY_NAME_MAP[k]
        return [f"{code}:1", f"{code}:0"]
    try:
        code = int(key_spec)
        return [f"{code}:1", f"{code}:0"]
    except ValueError:
        return [key_spec]

def send_key(key_name):
    events = key_to_events(key_name)
    return run_ydotool("key", *events)

def button_to_hex(button, state="click"):
    b_str = str(button).lower().strip()
    if b_str.startswith("0x"):
        return b_str

    btn_idx = 0x00
    if b_str in ("1", "left"):
        btn_idx = 0x00
    elif b_str in ("2", "middle"):
        btn_idx = 0x02
    elif b_str in ("3", "right"):
        btn_idx = 0x01
    else:
        try:
            btn_idx = int(b_str)
        except ValueError:
            btn_idx = 0x00

    if state == "click":
        return hex(0xC0 | btn_idx)
    elif state == "down":
        return hex(0x40 | btn_idx)
    elif state == "up":
        return hex(0x80 | btn_idx)
    return hex(0xC0 | btn_idx)

