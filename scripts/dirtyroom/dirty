def cmd_input_macro(args):
    macro_path = args.path
    if not os.path.isabs(macro_path):
        macro_path = os.path.abspath(macro_path)

    if not os.path.exists(macro_path):
        print(f"[!] Error: Macro file not found: {macro_path}", file=sys.stderr)
        return 1

    try:
        with open(macro_path, "r") as f:
            steps = json.load(f)
    except Exception as e:
        print(f"[!] Error parsing macro JSON: {e}", file=sys.stderr)
        return 1

    if not isinstance(steps, list):
        print("[!] Error: Macro file must contain a JSON array of action objects.", file=sys.stderr)
        return 1

    print(f"[*] Executing macro ({len(steps)} steps) from {macro_path}...")
    win = get_window_info("Paladins")

    for idx, step in enumerate(steps):
        act = step.get("action", "").lower()
        if act == "click":
            x = float(step.get("x", 0))
            y = float(step.get("y", 0))
            if step.get("relative", False) and win:
                x = int(win["x"] + x * win["width"])
                y = int(win["y"] + y * win["height"])
            else:
                x = int(x)
                y = int(y)
            btn = button_to_hex(step.get("button", 1), state="click")
            run_ydotool("mousemove", "--absolute", str(x), str(y))
            time.sleep(0.02)
            run_ydotool("click", btn)
        elif act in ("move", "mousemove"):
            x = float(step.get("x", 0))
            y = float(step.get("y", 0))
            if step.get("relative", False) and win:
                x = int(win["x"] + x * win["width"])
                y = int(win["y"] + y * win["height"])
            else:
                x = int(x)
                y = int(y)
            run_ydotool("mousemove", "--absolute", str(x), str(y))
        elif act == "drag":
            x1 = float(step.get("x1", 0))
            y1 = float(step.get("y1", 0))
            x2 = float(step.get("x2", 0))
            y2 = float(step.get("y2", 0))
            if step.get("relative", False) and win:
                x1 = win["x"] + x1 * win["width"]
                y1 = win["y"] + y1 * win["height"]
                x2 = win["x"] + x2 * win["width"]
                y2 = win["y"] + y2 * win["height"]
            duration_ms = float(step.get("duration", 300) or 300)
            btn_down = button_to_hex(step.get("button", 1), state="down")
            btn_up = button_to_hex(step.get("button", 1), state="up")
            run_ydotool("mousemove", "--absolute", str(int(x1)), str(int(y1)))
            time.sleep(0.02)
            run_ydotool("click", btn_down)
            st = max(10, int(duration_ms / 20))
            for i in range(1, st + 1):
                cur_x = int(x1 + (x2 - x1) * (i / st))
                cur_y = int(y1 + (y2 - y1) * (i / st))
                run_ydotool("mousemove", "--absolute", str(cur_x), str(cur_y))
                time.sleep((duration_ms / 1000.0) / st)
            time.sleep(0.02)
            run_ydotool("click", btn_up)
        elif act == "key":
            key_name = step.get("key", "")
            if key_name:
                send_key(key_name)
        elif act == "type":
            text = step.get("text", "")
            if text:
                run_ydotool("type", "--", text)
        elif act == "console":
            cmd_text = step.get("command", "")
            if win:
                subprocess.run(["xdotool", "windowactivate", "--sync", str(win["window_id"])], check=False)
                time.sleep(0.05)
            send_key("F10")
            time.sleep(0.1)
            run_ydotool("type", "--", cmd_text)
            time.sleep(0.05)
            send_key("Return")
        elif act in ("sleep", "wait"):
            ms = float(step.get("ms", 0))
            time.sleep(ms / 1000.0)
        elif act in ("activate", "focus"):
            target_name = step.get("name", "Paladins")
            w = get_window_info(target_name)
            if w:
                subprocess.run(["xdotool", "windowactivate", "--sync", str(w["window_id"])], check=False)
                time.sleep(0.05)
        else:
            print(f"[!] Warning: Unknown action '{act}' in step {idx}", file=sys.stderr)

    print("[*] Macro completed successfully.")
    return 0

