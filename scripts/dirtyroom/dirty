def cmd_mcts(args):
    conn = get_db()
    token = args.token
    try:
        val = int(token, 0)
        hex_val = f"0x{val:08x}"
    except ValueError:
        val = None
        hex_val = "unknown"

    matched = None
    if conn and val is not None:
        cursor = conn.cursor()
        cursor.execute("SELECT hash_uint32, hash_hex, token_name, raw_handler, notes FROM mcts_hashes WHERE hash_uint32 = ?", (val,))
        row = cursor.fetchone()
        if row:
            matched = {
                "token_name": row[2],
                "handler": row[3],
                "notes": row[4]
            }
        conn.close()

    if getattr(args, "json", False):
        res = {
            "query": token,
            "decimal": val,
            "hex": hex_val,
            "matched": matched
        }
        print(json.dumps(res, indent=2))
        return

    print(f"[*] Resolving MCTS token/function: {token}")
    print(f"  Decimal: {val}")
    print(f"  Hex:     {hex_val}")
    if matched:
        print(f"  Matched MCTS Hash Record:")
        print(f"    Token:   {matched['token_name']}")
        print(f"    Handler: {matched['handler']}")
        print(f"    Notes:   {matched['notes']}")
    else:
        print("  (Hash not yet mapped in database)")

def cmd_pcap(args):
    pcap_file = args.file
    if not os.path.isabs(pcap_file):
        candidate = os.path.join(PCAPS_DIR, pcap_file)
        if os.path.exists(candidate):
            pcap_file = candidate
            
    if not os.path.exists(pcap_file):
        print(f"Error: PCAP file not found: {pcap_file}", file=sys.stderr)
        return

    cmd = ["tshark", "-r", pcap_file, "-T", "fields"]
    fields = args.fields.split(",")
    for f in fields:
        cmd.extend(["-e", f.strip()])
        
    if args.filter:
        cmd.extend(["-Y", args.filter])
        
    cmd.extend(["-c", str(args.limit)])
    
    try:
        proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)
        lines = proc.stdout.strip().splitlines()
        print(f"[*] PCAP Inspection: {os.path.basename(pcap_file)} (Filter: '{args.filter or 'none'}', Top {len(lines)} frames):")
        print(" | ".join(f.strip() for f in fields))
        print("-" * 60)
        for l in lines:
            print(" | ".join(l.split("\t")))
    except Exception as e:
        print(f"Error executing tshark: {e}", file=sys.stderr)

