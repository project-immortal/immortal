"""
DEPRECATED: Legacy 'dirty' CLI forwarder.
Forwarding calls to canonical 'agyis re' and modular 'agyis <cmd>' (ADR-034).
"""

import os
from pathlib import Path
import subprocess
import sys

REPO_ROOT = Path(__file__).resolve().parent.parent.parent
AGYIS_BIN = shutil_which = Path(sys.executable).parent / "agyis"
if not AGYIS_BIN.is_file():
    AGYIS_BIN = Path("/home/kuasha/.gemini/antigravity/bin/agyis")
if not AGYIS_BIN.is_file():
    AGYIS_BIN = Path(subprocess.run(["which", "agyis"], stdout=subprocess.PIPE, text=True).stdout.strip())


def main():
    args = sys.argv[1:]
    if not args:
        print("[!] DeprecationNotice: 'dirty' is retired in favor of 'agyis re' and 'agyis <cmd>'.", file=sys.stderr)
        print("    Run 'agyis ext list' or 'agyis re --help' for canonical commands.\n", file=sys.stderr)
        cmd = [str(AGYIS_BIN), "ext", "list"]
        return subprocess.run(cmd).returncode

    subcmd = args[0]
    rest = args[1:]

    RE_COMMANDS = {
        "status": "status",
        "find": "find",
        "string": "find",
        "rtti": "find",
        "decompile": "decompile",
        "pcap": "pcap",
        "disasm": "disasm",
        "xrefs": "xrefs",
        "patch-rea": "patch-rea",
        "init": "init",
        "pre-analyze": "pre-analyze",
    }

    BESPOKE_COMMANDS = {"flight", "game", "mcts", "record", "input", "screenshot"}

    print(f"[!] DeprecationNotice: Forwarding 'dirty {subcmd}' to canonical agyis toolsuite...", file=sys.stderr)

    if subcmd in RE_COMMANDS:
        target_subcmd = RE_COMMANDS[subcmd]
        forward_args = [str(AGYIS_BIN), "re", target_subcmd]
        if subcmd == "string":
            forward_args.extend(["--type", "str"])
        elif subcmd == "rtti":
            forward_args.extend(["--type", "rtti"])
        forward_args.extend(rest)
        return subprocess.run(forward_args).returncode

    elif subcmd in BESPOKE_COMMANDS:
        forward_args = [str(AGYIS_BIN), subcmd] + rest
        return subprocess.run(forward_args).returncode

    else:
        # Fallback to general agyis execution
        return subprocess.run([str(AGYIS_BIN)] + args).returncode


if __name__ == "__main__":
    sys.exit(main())
