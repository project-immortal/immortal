def main():
    parser = argparse.ArgumentParser(description="Immortal Dirty-Room Reverse Engineering CLI")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_status = sub.add_parser("status", help="Show dirty-room environment status")
    p_status.add_argument("--json", action="store_true", help="Output as JSON")
    p_status.set_defaults(func=cmd_status)

    p_find = sub.add_parser("find", help="Find functions or symbols in the indexed database")
    p_find.add_argument("query", help="Search query (substring)")
    p_find.add_argument("--limit", type=int, default=25, help="Max results")
    p_find.add_argument("--json", action="store_true", help="Output as JSON")
    p_find.add_argument("--evidence", action="store_true", help="Format as Cleanroom Evidence Markdown")
    p_find.set_defaults(func=cmd_find)

    p_str = sub.add_parser("string", help="Find string in indexed database")
    p_str.add_argument("query", help="Search query (substring)")
    p_str.add_argument("--limit", type=int, default=25, help="Max results")
    p_str.add_argument("--json", action="store_true", help="Output as JSON")
    p_str.add_argument("--evidence", action="store_true", help="Format as Cleanroom Evidence Markdown")
    p_str.set_defaults(func=cmd_string)

    p_rtti = sub.add_parser("rtti", help="Find RTTI C++ class in indexed database")
    p_rtti.add_argument("query", help="Search query (substring)")
    p_rtti.add_argument("--limit", type=int, default=25, help="Max results")
    p_rtti.add_argument("--json", action="store_true", help="Output as JSON")
    p_rtti.set_defaults(func=cmd_rtti)

    p_decomp = sub.add_parser("decompile", help="Decompile function via headless Ghidra")
    p_decomp.add_argument("target", help="Address (0x...) or function symbol name")
    p_decomp.add_argument("--binary", default="ShippingPC-ChaosGame.exe", help="Target binary in project")
    p_decomp.set_defaults(func=cmd_decompile)

    p_mcts = sub.add_parser("mcts", help="Look up or calculate MCTS marshal tokens")
